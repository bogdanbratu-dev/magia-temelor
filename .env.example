# Parola pentru panoul de administrare (/admin)
ADMIN_PASSWORD=schimba-aceasta-parola

# Cheie secretă folosită pentru a semna sesiunea de admin (orice text lung, aleator)
AUTH_SECRET=schimba-acest-text-lung-si-aleator

# Token pentru Vercel Blob (Storage -> Blob în dashboard-ul Vercel).
# Fără el, site-ul rulează local salvând conținutul într-un fișier local (.data/site-content.json).
BLOB_READ_WRITE_TOKEN=

# Opțional: cheie Resend pentru trimiterea emailurilor din formularul de contact
RESEND_API_KEY=
CONTACT_TO_EMAIL=roxana.trandafir@scoala86.ro
